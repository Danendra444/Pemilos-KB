# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Kunci "service_role" (atau "secret key" sb_secret_...). JANGAN pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Username panel admin (/osisgod).
ADMIN_USERNAME=

# Password panel admin (/osisgod). Gunakan password yang panjang.
ADMIN_PASSWORD=

# Rahasia acak minimal 32 karakter untuk menandatangani sesi admin.
# Buat dengan: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Opsional: kunci tautan bilik demo /demo/<kunci>/putra dan /demo/<kunci>/putri
# (tanpa akun bilik, hanya token Uji Coba). Minimal 16 karakter. Kosongkan untuk mematikan.
# Buat dengan: openssl rand -hex 12
DEMO_BOOTH_KEY=
